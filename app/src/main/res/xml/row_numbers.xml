<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <switch>
        <case
            latin:numberRowEnabled="true"
        >
            <Row
                latin:keyWidth="10%p"
            >
                <Key
                    latin:keySpec="1" />
                <Key
                    latin:keySpec="2" />
                <Key
                    latin:keySpec="3" />
                <Key
                    latin:keySpec="4" />
                <Key
                    latin:keySpec="5" />
                <Key
                    latin:keySpec="6" />
                <Key
                    latin:keySpec="7" />
                <Key
                    latin:keySpec="8" />
                <Key
                    latin:keySpec="9" />
                <Key
                    latin:keySpec="0" />
            </Row>
        </case>
    </switch>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_activated="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="?attr/keyboardPopupSelectedColor" />
            <stroke android:width="1dp" android:color="?attr/keyboardActionColor" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="?attr/keyboardPopupSelectedColor" />
            <stroke android:width="1dp" android:color="?attr/keyboardActionColor" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="?attr/keyboardPopupSelectedColor" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="?attr/keyboardPopupColor" />
        </shape>
    </item>
</selector>

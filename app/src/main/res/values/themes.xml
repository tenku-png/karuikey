    <style name="Theme.Karuikey.Keyboard.Dynamic.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="keyboardKeyColor">?attr/colorSurfaceVariant</item>
        <item name="keyboardFunctionalColor">?attr/colorSecondaryContainer</item>
        <item name="keyboardActionColor">?attr/colorPrimary</item>
        <item name="keyboardActionTextColor">?attr/colorOnPrimary</item>
        <item name="keyboardPressedColor">?attr/colorPrimaryContainer</item>
        <item name="keyboardShiftLockedColor">?attr/colorPrimaryContainer</item>
        <item name="keyboardTextColor">?attr/colorOnSurface</item>
        <item name="keyboardSecondaryTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="keyboardFunctionalTextColor">?attr/colorOnSurface</item>
        <item name="keyboardDisabledTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="keyboardPopupColor">?attr/colorSurface</item>
        <item name="keyboardPopupSelectedColor">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Theme.Karuikey.Keyboard.Dynamic.Dark" parent="Theme.Material3.Dark.NoActionBar">

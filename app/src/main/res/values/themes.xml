    <style name="Theme.Karuikey.Keyboard.Fallback.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="keyboardKeyColor">@color/keyboard_light_key</item>
        <item name="keyboardFunctionalColor">@color/keyboard_light_functional</item>
